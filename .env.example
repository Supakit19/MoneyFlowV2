# Local application. Never commit credentials or share .env.
APP_PORT=3011
DATABASE_URL=postgres://moneyflow:moneyflow_local@127.0.0.1:55432/moneyflow
WEB_ORIGIN=http://localhost:5178
APP_PUBLIC_URL=
NODE_ENV=development

# LINE Developers > Messaging API. Can remain empty until you connect LINE.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GEMINI_MODEL=gemini-3.5-flash-lite

# Google login (OAuth 2.0 client ID and approved owner Google email)
GOOGLE_CLIENT_ID=

# Optional hosted LINEJS connectors for 3-4 users on this API machine.
# Set LINEJS_HOSTED_ENABLED=1 only after generating a stable private key:
# openssl rand -hex 32
# Store the key only in the non-committed .env file.
LINEJS_HOSTED_ENABLED=0
LINEJS_HOSTED_MAX_WORKERS=4
LINEJS_SESSION_ENCRYPTION_KEY=
