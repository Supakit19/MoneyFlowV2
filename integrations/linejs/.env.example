# The LINEJS listener is OFF unless explicitly enabled.
LINEJS_WORKER_ENABLED=0

# User-specific bridge token: generate in MoneyFlow > LINE & AI.
# Never send this to anyone or commit it.
MONEYFLOW_BANK_INGEST_TOKEN=

# Exact sender MID from your trusted bank's LINE chat, NOT the public @handle.
LINEJS_BANK_SENDER_MID=

# Discovery mode prints only bank-like sender MIDs; it forwards nothing.
LINEJS_DISCOVER_SENDER=0

# Local MoneyFlow API; if remote, require HTTPS.
MONEYFLOW_BANK_API=http://127.0.0.1:3011
