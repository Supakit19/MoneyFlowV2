# COPY to .env.production on your deployment host, then replace placeholders.
# NEVER commit or send .env.production, tokens, or database passwords.
NODE_ENV=production
APP_PORT=3011
LISTEN_HOST=0.0.0.0
HTTP_PORT=8080
WEB_ORIGIN=https://moneyflow.example.com
APP_PUBLIC_URL=https://moneyflow.example.com

# Password and DATABASE_URL must match. Percent-encode reserved URL characters in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://moneyflow:CHANGE_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/moneyflow

# Google Cloud > OAuth Clients > Authorized JavaScript origins:
# https://moneyflow.example.com
GOOGLE_CLIENT_ID=

# LINE webhook: https://moneyflow.example.com/webhook/line
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional: otherwise read the LINE Official Account Basic ID via Messaging API.
LINE_OFFICIAL_ACCOUNT_ID=

# LINE Developers > LINE Login channel (same provider as Messaging API above).
# Register https://moneyflow.example.com/api/auth/line/qr/callback under Callback URL.
# Do not reuse the Messaging API LINE_CHANNEL_SECRET here.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
